# Copy this file to .env and fill in your values.
# Use the Supabase pooler connection string (port 6543), NOT the direct
# connection (port 5432) — direct fails with IPv6 routing on Supabase.
# Project Settings -> Database -> Connection string -> "Transaction" pooler.
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@[host].pooler.supabase.com:6543/postgres
